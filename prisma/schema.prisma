// Prisma Schema for Clipper Web SaaS
// Extended with Better Auth user fields

generator client {
  provider "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// Extended User Model (Better Auth Integration)
// ═══════════════════════════════════════════════

model User {
  id              String     @id @default(uuid())
  email           String     @unique @email
  emailVerified   DateTime?
  password        String

  // Better Auth extended fields
  betterAuthUserId String     @unique @map("better_auth_user_id")

  // Extended user profile fields
  fullName        String?    @db.VarChar(191)
  company         String?    @db.VarChar(191)
  plan            Enum       ["free", "starter", "pro", "business"] @default("free") @db.VarChar(32)
  credits         Integer    @default(100)
  subscriptionId  String?    @db.VarChar(191)
  lastLoginAt     DateTime?

  // Timestamps
  createdAt       DateTime   @default(now)
  updatedAt       DateTime   @updatedAt

  // Relations
  clips           Clip[]
  aiJobs          AIJob[]
  // ... existing relations
}

// ═══════════════════════════════════════════════
// Core Models (existing, referenced by User)
// ═══════════════════════════════════════════════

model Clip {
  id              String     @id @default(uuid())
  user            User       @relation(fields: [userId], references: [id])
  userId          String
  title           String
  description     String?
  sourceVideo     String     // video ID or path
  duration        Integer    // in seconds
  aspectRatio     String     // e.g., "9:16", "16:9"
  viralScore      Integer    // 0-100
  status          String     // "processing", "completed", "failed"
  creditsConsumed Integer    // how many credits used
  createdAt       DateTime   @default(now)
  updatedAt       DateTime   @updatedAt

  @@ index([userId])
  @@ index([status])
}

model AIJob {
  id              String     @id @default(uuid())
  user            User       @relation(fields: [userId], references: [id])
  userId          String
  jobType         String     // "title_generation", "subtitle", "thumbnail", etc.
  status          String     // "pending", "processing", "completed", "failed"
  inputParameters Json?      // flexible input for AI pipeline
  outputResult    Json?      // AI output result
  creditsCost     Integer    // credits consumed
  completedAt     DateTime?
  createdAt       DateTime   @default(now)

  @@ index([userId])
  @@ index([status])
}

// ═══════════════════════════════════════════════
// A/B Experiment Models (Phase 3: Growth Experiments)
// ═══════════════════════════════════════════════

model A/BExperiment {
  id          String     @id @default(uuid())
  key         String     @unique   // e.g., "title_generator_v3", "thumbnail_style_a"
  name        String
  description String?
  
  // Experiment configuration
  status      String     // "draft", "running", "paused", "completed", "archived"
  strategy    String     // "percentage", "user_list", "feature_flag"
  
  // Traffic split
  percentage  Float?     // 0-100 for percentage-based
  userIds     String[]?  // for user_list strategy
  
  // Experiment metadata
  metric      String     // primary success metric
  variantA    String     // e.g., "prompt_v3"
  variantB    String     // e.g., "prompt_v4"
  
  // Results tracking
  sampleSize  Integer    // number of users participated
  conversions Integer    // conversions for primary metric
  startedAt   DateTime
  completedAt DateTime?
  
  // Audit
  createdBy   String
  createdAt   DateTime @default(now)
  updatedAt   DateTime @updatedAt
  
  // Indexes
  @@ index([key])
}

model A/BExperimentUser {
  id         String @id @default(uuid())
  experiment String     // reference to A/BExperiment.key
  userId     String    // who is in this experiment
  variant    String    // "A" or "B"
  assignedAt DateTime   // when assigned
  converted   Boolean   // did they convert on the metric?
  
  unique([experiment, userId])
}

